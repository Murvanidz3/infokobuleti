APP_NAME=infokobuleti
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tbilisi

APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ka_GE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infokobuleti
DB_USERNAME=infokobuleti
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# pgsql: PostgreSQL search (no extra service); meilisearch on staging and production.
SCOUT_DRIVER=pgsql
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@infokobuleti.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Fallback GEL rates until the National Bank of Georgia driver is wired up
CURRENCY_RATE_USD=2.71
CURRENCY_RATE_EUR=3.14

# Password for the seeded demo staff accounts (local and staging only)
DEMO_PASSWORD=

# Authentication (Phase 4)
# "Remember me" duration in minutes (30 days)
AUTH_REMEMBER_MINUTES=43200
# Google OAuth client; register <APP_URL>/auth/google/callback as the redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
# Cloudflare Turnstile on the "send code" step (empty = check disabled)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS: log (writes to the log), ubill (UBill, production) or twilio
SMS_DRIVER=log
SMS_SENDER=INFOKOBULETI
# Show login codes on screen with the log driver (never in production)
SMS_REVEAL_CODES=false
UBILL_API_KEY=
UBILL_BRAND_ID=
UBILL_CALLBACK_KEY=
UBILL_MIN_BALANCE=200
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Address search on the add-listing map: nominatim (OpenStreetMap, max 1 request/second) or fake
GEOCODER_DRIVER=nominatim
NOMINATIM_USER_AGENT="infokobuleti.com (info@infokobuleti.com)"

VITE_APP_NAME="${APP_NAME}"


# Card payments (Phase 8). Gateways offered at checkout, in order: fake (test bank, never in
# production), bog (Bank of Georgia), tbc (TBC Bank).
PAYMENT_GATEWAYS=fake
FAKE_PAYMENTS_SECRET=
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# The bank's callback public key from api.bog.ge/docs/en/payments (PEM, one line with \n is fine)
BOG_CALLBACK_PUBLIC_KEY=
TBC_API_KEY=
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
INVOICE_PREFIX=IK
INVOICE_SELLER_NAME=infokobuleti.com
INVOICE_SELLER_TAX_ID=
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_IBAN=
